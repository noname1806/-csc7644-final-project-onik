# Permission-to-Policy Checker — environment variables
#
# Copy this file to `.env` and fill in only the keys you want to use.
# None of these are required to run the project: the `heuristic` backend
# works with no keys at all, and the `llama` backend uses a local Ollama
# server that needs no key.
#
# DO NOT commit `.env` to version control. It is listed in .gitignore.


# Anthropic Claude — used by `--backend claude` and `--backend agent-claude`.
# Get one at https://console.anthropic.com/  (paid; ~$0.02 per audit)
ANTHROPIC_API_KEY=


# Groq cloud (Llama 3.3 70B) — used by `--backend groq` and `--backend agent-groq`.
# Get a free key at https://console.groq.com/keys  (no credit card required)
GROQ_API_KEY=


# Optional: override the default Ollama endpoint (only needed if Ollama runs
# on a non-default host or port).
# OLLAMA_BASE=http://localhost:11434/v1
